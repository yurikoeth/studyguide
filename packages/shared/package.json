{
  "name": "@comptia-study/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./types": {
      "import": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./srs": {
      "import": "./src/srs/index.ts",
      "default": "./dist/srs/index.js"
    },
    "./gamification": {
      "import": "./src/gamification/index.ts",
      "default": "./dist/gamification/index.js"
    },
    "./ai": {
      "import": "./src/ai/index.ts",
      "default": "./dist/ai/index.js"
    },
    "./data": {
      "import": "./src/data/index.ts",
      "default": "./dist/data/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "zod": "^3.24.0"
  }
}
